{
  "name": "11-child-expiry",
  "description": "Delegated capability expires even while the parent remains valid.",
  "grants": [
    {
      "id": "root",
      "principal": "agent",
      "resource": "doc:42",
      "actions": [
        "read"
      ],
      "expires_at": 50
    },
    {
      "id": "child",
      "principal": "worker",
      "resource": "doc:42",
      "actions": [
        "read"
      ],
      "expires_at": 4,
      "parent_id": "root"
    }
  ],
  "steps": [
    {
      "at": 3,
      "op": "plan",
      "call_id": "call1",
      "cap_id": "child",
      "principal": "worker",
      "action": "read",
      "resource": "doc:42"
    },
    {
      "at": 4,
      "op": "dispatch",
      "call_id": "call1"
    }
  ],
  "expected": {
    "call1": false
  }
}
