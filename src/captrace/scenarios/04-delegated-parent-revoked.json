{
  "name": "04-delegated-parent-revoked",
  "description": "Revoking an ancestor must invalidate a delegated capability.",
  "grants": [
    {
      "id": "root",
      "principal": "agent",
      "resource": "doc:42",
      "actions": [
        "read"
      ],
      "expires_at": 50
    },
    {
      "id": "child",
      "principal": "worker",
      "resource": "doc:42",
      "actions": [
        "read"
      ],
      "expires_at": 30,
      "parent_id": "root"
    }
  ],
  "steps": [
    {
      "at": 2,
      "op": "plan",
      "call_id": "call1",
      "cap_id": "child",
      "principal": "worker",
      "action": "read",
      "resource": "doc:42"
    },
    {
      "at": 3,
      "op": "revoke",
      "cap_id": "root"
    },
    {
      "at": 4,
      "op": "dispatch",
      "call_id": "call1"
    }
  ],
  "expected": {
    "call1": false
  }
}
